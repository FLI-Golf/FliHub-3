# FliHub environment configuration (server-only)
#
# Copy this file to `.env` and adjust the values. `.env` is git-ignored and
# must never be committed. This example contains no secrets.
#
# The application starts without any configuration and displays setup
# instructions, so every variable below is optional for local development.

# Base URL of the PocketBase instance the FliHub server talks to.
# Read only on the server; it is never bundled into browser code.
# See pocketbase/README.md for running a free local development instance.
POCKETBASE_URL=http://127.0.0.1:8090

# Superuser credentials for trusted server-side operations only (e.g.
# transactional membership changes). Never use the superuser as the normal
# application identity. Keep real values in your git-ignored `.env` only —
# this example file must stay secret-free.
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=admin123

POCKETBASE_USER_EMAIL=user@example.com
POCKETBASE_USER_PASSWORD=user123



ELEVENLABS_API_KEY=your_key_here

