FROM alpine:3.22

RUN apk add --no-cache ca-certificates unzip wget \
    && wget -q -O /tmp/pocketbase.zip https://github.com/pocketbase/pocketbase/releases/download/v0.40.6/pocketbase_0.40.6_linux_amd64.zip \
    && mkdir -p /pb \
    && unzip /tmp/pocketbase.zip pocketbase -d /pb \
    && rm /tmp/pocketbase.zip \
    && /pb/pocketbase --version | grep -Fx 'pocketbase version 0.40.6'

WORKDIR /pb

COPY pocketbase/pb_hooks/ /pb/pb_hooks/
COPY pocketbase/pb_migrations/ /pb/pb_migrations/
# Hooks resolve ../../src/lib/capabilities/catalog.json from /pb/pb_hooks.
COPY src/lib/capabilities/catalog.json /src/lib/capabilities/catalog.json

ENV FLIHUB_DEMO_FANTASY=0 \
    FLIHUB_FANTASY_DEMO_CLOCK=0

EXPOSE 8080

CMD ["/pb/pocketbase", "serve", "--http=0.0.0.0:8080", "--dir=/pb/pb_data", "--hooksDir=/pb/pb_hooks", "--migrationsDir=/pb/pb_migrations"]
