# PocketBase local development (see pocketbase/README.md)
# Database contents, uploaded files, and the downloaded executable are ignored.
# pb_migrations/ is intentionally NOT ignored — schema migrations are committed.
/pocketbase/pb_data/
/pocketbase/pocketbase
/pocketbase/pocketbase.exe
/pocketbase/*.zip
/pocketbase/mailpit
/pocketbase/CHANGELOG.md
/pocketbase/LICENSE.md

# Test artifacts (E2E screenshots, Playwright reports/traces/videos/session state)
/tests/e2e/output/
/test-results/
/playwright-report/
/playwright/.auth/
/playwright/.cache/
*.webm

# Walkthrough recording output (raw segments, frames, narration cache,
# assembled intermediates) stays untracked.
# EXCEPTION (intentional, versioned playback assets): the reviewed silent
# original, narrated cut, and captions in static/walkthroughs/ ARE committed
# so the walkthrough works after a fresh checkout (see recordings/README.md).
/recordings/output/
!/static/walkthroughs/*.webm

# Unpublished walkthrough review previews (temporary, local only)
/static/review/
